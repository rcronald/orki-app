# Credenciales de la CLI de Supabase para el proyecto de DESARROLLO.
# Copia este archivo a supabase/.env (ignorado por git) y completa los valores.
# Nunca pongas aquí las credenciales de producción: las migraciones en producción
# las aplica el workflow de GitHub Actions.
#
# Las usan npm run db:status y npm run db:push. Si una variable ya está definida en el
# entorno, se usa esa y se ignora la de este archivo.

# Token de acceso personal de Supabase: Dashboard > Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=

# Contraseña de la base de datos del proyecto de desarrollo:
# Project Settings > Database (se puede restablecer ahí si no la tienes).
SUPABASE_DB_PASSWORD=

# Identificador (ref) del proyecto de desarrollo: Project Settings > General > Project ID.
# Son 20 letras minúsculas; también aparece en la URL https://<ref>.supabase.co.
SUPABASE_PROJECT_REF=

# Solo para los scripts de mantenimiento que ven los datos de todos los usuarios
# (npm run fotos:huerfanas y npm run datos:sin-dueno). Déjalas vacías y defínelas solo
# mientras ejecutas el script: se saltan RLS y pueden borrar datos de cualquier usuario.
# Aquí van solo las de desarrollo; con --ambiente produccion, npm run datos:sin-dueno no
# lee este archivo y exige las credenciales en el entorno.
#
# Clave secreta del proyecto de desarrollo (sb_secret_...): Project Settings > API Keys.
SUPABASE_SECRET_KEY=
#
# Clave secreta de la instancia de desarrollo de Clerk (sk_test_...): panel de Clerk >
# Configure > API keys. Solo la usa npm run datos:sin-dueno, para consultar usuarios.
CLERK_SECRET_KEY=
