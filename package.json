{
  "name": "orki",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web --",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web --",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "enlaces": "node scripts/enlaces/index.mjs",
    "test": "npm run test --workspace=apps/web --",
    "test:watch": "npm run test:watch --workspace=apps/web --",
    "db:new": "node scripts/supabase-db.mjs nueva",
    "db:status": "node scripts/supabase-db.mjs estado",
    "db:push": "node scripts/supabase-db.mjs aplicar",
    "db:seed:dev": "node scripts/supabase-db.mjs datos-ejemplo",
    "db:seed:plants": "node scripts/supabase-db.mjs plantas-ejemplo",
    "db:test": "node scripts/db-test.mjs",
    "db:concurrencia": "node --test supabase/tests/concurrencia.test.mjs",
    "db:perf": "node scripts/db-perf.mjs",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --comprobar",
    "fotos:huerfanas": "node scripts/fotos-huerfanas.mjs",
    "datos:sin-dueno": "node scripts/datos-sin-dueno/index.mjs",
    "build:medicion": "node scripts/construir-medicion.mjs",
    "presupuesto": "node scripts/presupuesto-tamano.mjs",
    "medir:carga": "node scripts/medir-carga.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "build:e2e": "node scripts/construir-e2e.mjs",
    "test:e2e": "npm run build:e2e && npm run test:e2e:sin-build --",
    "test:e2e:sin-build": "npm run test:e2e --workspace=apps/web --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.119.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
